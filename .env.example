# Leave TAVILY_API_KEY empty to run in clearly-labelled DEMO mode (simulated sources).
TAVILY_API_KEY=
# Optional OpenAI-compatible LLM (extraction + evidence judging). Empty = deterministic heuristic engine.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
TRUTHGUARD_API_KEYS=
DB_PATH=truthguard.db
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MIN=30
UI_ENABLED=true
RETENTION_DAYS=30
# STATIC_DIR=../frontend/dist   (serve the built web app from the API server)
